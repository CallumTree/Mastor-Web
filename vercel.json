{
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/oauth-resource"
    },
    {
      "source": "/oauth/consent",
      "destination": "/app.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/mcp.js": {
      "maxDuration": 300
    }
  }
}
